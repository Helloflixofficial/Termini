# Duplicate as .env.local for development. Never commit real credentials.
# Vercel: configure these in Project Settings > Environment Variables.

# Neon pooled connection string (serverless app traffic)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true
# Neon direct connection string used only by Prisma migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Clerk
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev

# Teacher/admin Clerk user IDs; server-only. Comma-separated.
TEACHER_IDS=user_xxxxxxxxxxxxxxxxx

# Payments / course media / file upload / meetings
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
MUX_TOKEN_ID=replace_me
MUX_TOKEN_SECRET=replace_me
# Mux signed-playback key (base64-encoded PEM private key from Mux signing keys)
MUX_SIGNING_KEY_ID=replace_me
MUX_PRIVATE_KEY=base64_encoded_pem_private_key
UPLOADTHING_SECRET=replace_me
UPLOADTHING_APP_ID=replace_me
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
LIVEKIT_URL=wss://replace-me.livekit.cloud

# Public callback base URL, and exact browser origins (comma-separated origins only)
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://your-app.example
