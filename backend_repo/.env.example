# Copy this file to .env and fill in the credentials for the services you use.
# Never commit backend_repo/.env or put secret keys in the Flutter app.

# Neon/PostgreSQL connection strings. DIRECT_URL may use the same value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Course media and file uploads
MUX_TOKEN_ID=replace_me
MUX_TOKEN_SECRET=replace_me
UPLOADTHING_SECRET=replace_me
UPLOADTHING_APP_ID=replace_me

# Payments (only needed for checkout and Stripe webhooks)
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Live classes (only needed for LiveKit meetings)
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
NEXT_PUBLIC_LIVEKIT_URL=wss://replace-me.livekit.cloud

# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TEACHER_ID=
PORT=3000
