# ==============================================================================
# Flutter Environment Variables Configuration
# ==============================================================================
# Pass these via --dart-define or place them in a local gitignored .env file.
# Note: Keep all secret keys (Clerk secret, Stripe secret, DB URL, Mux secrets)
# strictly in the Next.js backend .env.
# ==============================================================================

# API Base URL pointing to the Next.js backend:
# - Android Emulator: http://10.0.2.2:3000
# - Real Phone (via USB reverse / LAN IP): http://localhost:3000 or http://<YOUR_LAN_IP>:3000
# - Web / Windows / macOS / Linux: http://localhost:3000
API_BASE_URL=http://10.0.2.2:3000

# Clerk Publishable Key (from Clerk Dashboard > API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_sample_key

# LiveKit Server WebSocket URL (e.g. wss://your-livekit-server.livekit.cloud)
LIVEKIT_URL=wss://livekit.example.com

# Stripe Publishable Key (optional for client-side Stripe integrations)
STRIPE_PUBLISHABLE_KEY=pk_test_sample_stripe_key
